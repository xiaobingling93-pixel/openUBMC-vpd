{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2cMux_Chan"
            ]
        },
        "I2cMux_Chan": {
            "Chips": [
                "Chip_M11P"
            ]
        }
    },
    "Objects": {
        "Chip_M11P": {
            "Address": 158,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
        "MidAvg_GPUTemp": {
            "WindowSize": 4,
            "DefaultValue": 20,
            "IsSigned": true
        },
        "Scanner_GPUTemp": {
            "Chip": "#/Chip_M11P",
            "Size": 2,
            "Offset": 156,
            "Mask": 65535,
            "Period": 1000,
            "Debounce": "#/MidAvg_GPUTemp",
            "Type": 0
        },
        "GPU_1": {
            "SystemId": 1,
            "Id": 1,
            "Name": "AWM M11P",
            "Presence": 1,
            "Manufacturer": "ALLWINMETA",
            "Model": "AWM M11P",
            "SN": "",
            "SocketDesignation": "1",
            "Position": "PCIe Riser${Slot}",
            "ProcessorType": "2",
            "Health": "#/Component_PCIeCard.Health",
            "Slot": "<=/PCIeDevice_1.SlotID",
            "VendorID": 8160,
            "DeviceID": 4112,
            "SubVendorID": 8160,
            "SubDeviceID": 4112,
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "RefChip": "#/Chip_M11P",
            "PrimaryGPUTemperatureCelsius": "<=/Scanner_GPUTemp.Value |> expr($1 // 256)"
        },
        "PCIeDevice_1": {
            "DeviceName": "PCIe Card $ (AWM M11P)",
            "DeviceType": 8,
            "FunctionClass": 3,
            "Container": "${Container}",
            "GroupPosition": "PCIeDevice_${GroupPosition}",
            "BandwidthReduction": 0,
            "CorrectableError": 0,
            "UncorrectableError": 0,
            "FatalError": 0,
            "LinkSpeedReduced": 0,
            "PCIeDeviceType": "SingleFunction",
            "SlotType": "FullLength",
            "FunctionProtocol": "PCIe",
            "FunctionType": "Physical"
        },
        "PCIeCard_1": {
            "SlotID": "<=/PCIeDevice_1.SlotID",
            "NodeID": "<=/PCIeDevice_1.SlotID |> string.format('PCIeCard%s',$1)",
            "Name": "AWM M11P",
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "Description": "AWM M11P",
            "FunctionClass": 3,
            "VendorID": 8160,
            "DeviceID": 4112,
            "SubVendorID": 8160,
            "SubDeviceID": 4112,
            "Position": "<=/PCIeDevice_1.Position",
            "LaneOwner": "<=/PCIeDevice_1.SocketID",
            "Manufacturer": "ALLWINMETA",
            "PartNumber": "",
            "PcbVersion": "N/A",
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "SerialNumber": "<=/GPU_1.SN"
        },
        "BoardPCIeCard_1": {
            "Slot": "<=/PCIeDevice_1.SlotID",
            "UID": "N/A",
            "Name": "N/A",
            "Manufacturer": "ALLWINMETA",
            "Type": "PCIeCard",
            "Description": "AWM M11P",
            "PartNumber": "",
            "PcbID": 0,
            "LogicVersion": "N/A",
            "SRVersion": "",
            "BoardType": "BoardPCIeCard",
            "Number": 1,
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "Position": "<=/PCIeDevice_1.Position",
            "BoardNodeId": "<=/PCIeDevice_1.DeviceName",
            "FruID": 255
        },
        "Entity_GPUCard": {
            "Id": 11,
            "Name": "GPUCard",
            "PowerState": 1,
            "Presence": 1,
            "Instance": 101
        },
        "ThresholdSensor_M11PGPUTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_GPUCard.Id",
            "EntityInstance": "<=/Entity_GPUCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "GPU${Slot} Temp",
            "Unit": 128,
            "BaseUnit": 1,
            "NominalReading": 25,
            "MaximumReading": 127,
            "AssertMask": 128,
            "DeassertMask": 12416,
            "ReadingMask": 2056,
            "M": 100,
            "RBExp": 224,
            "Analog": 1,
            "Reading": "<=/Scanner_GPUTemp.Value |> expr($1 // 256)",
            "ReadingStatus": "<=/Scanner_GPUTemp.Value |> expr($1 >= 32768 ? 1 : 0)",
            "SensorNumber": 255,
            "UpperNoncritical": 85,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "CoolingRequirement_1_87": {
            "RequirementId": "${Slot} |> expr((87 << 8) | $1)",
            "TemperatureType": 1,
            "MonitoringStatus": "<=/Scanner_GPUTemp.Value |> expr($1 >= 65536 ? 1 : 0)",
            "MonitoringValue": "<=/Scanner_GPUTemp.Value |> expr((($1 // 256) > 255) ? 30 : (((($1 // 256) & 255) >= 128) ? (-(255 - (($1 // 256) & 255) + 1)) : (($1 // 256) & 255)) )",
            "FailedValue": 80,
            "TargetTemperatureCelsius": 70,
            "MaxAllowedTemperatureCelsius": 78
        },
        "Event_OverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Condition": "<=/ThresholdSensor_M11PGPUTemp.UpperNoncritical",
            "Hysteresis": "<=/ThresholdSensor_M11PGPUTemp.PositiveHysteresis"
        },
        "Event_TempFail": {
            "EventKeyId": "PcieCard.PCIeCardTempFail",
            "Condition": 1
        },
        "Event_PCIeCardUCE": {
            "EventKeyId": "PCIeCard.PCIeCardUncorrectableErr",
            "Condition": 1,
            "LedFaultCode": "q$$"
        },
        "Event_PCIeCardCE": {
            "EventKeyId": "PCIeCard.PCIeCardCEHardFailure",
            "Condition": 1,
            "LedFaultCode": "q$$"
        },
        "Event_PcieCardReplaceMntr": {
            "EventKeyId": "PcieCard.PcieCardReplace",
            "Condition": 1
        },
        "Event_PCIeBandWidth": {
            "EventKeyId": "PCIeCard.PCIeCardBandWidthDecreased",
            "Condition": 1
        }
    }
}