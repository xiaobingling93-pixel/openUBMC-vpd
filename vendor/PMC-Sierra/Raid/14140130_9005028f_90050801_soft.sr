{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "Objects": {
        "Component_PCIeCard": {
            "FruId": 255,
            "Type": 8,
            "Health": 0,
            "PowerState": 1,
            "GroupId": 1,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Presence": 1,
            "ReplaceFlag": 0,
            "PreviousSN": "N/A",
            "SerialNumber": "<=/PCIeCard_1.SerialNumber"
        },
        "Component_Battery": {
            "FruId": 255,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Type": 8,
            "Name": "PCIe Card BBU",
            "Presence": 1,
            "Health": 0,
            "PowerState": 1
        },
        "Event_PCIeRaidComLossMntr": {
            "Reading": "<=/Controller_1.CommunicationLoss",
            "@Default": {
                "Reading": 0
            },
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/Component_PCIeCard.Instance",
            "DescArg3": "3152-8i",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeRAIDCardFault": {
            "Reading": "<=/Controller_1.FaultCode",
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SAS 3152",
            "Component": "#/Component_PCIeCard"
        },
        "Event_BatteryFault": {
            "Reading": "<=/Controller_1.BatteryFault",
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SAS 3152",
            "Component": "#/Component_Battery"
        },
        "Event_PCIeBandWidth": {
            "Reading": "<=/PCIeDevice_1.BandwidthReduction",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(SAS 3152)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardUCE": {
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.DeviceName",
            "DescArg4": "#/Controller_1.FaultCode",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardCE": {
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.DeviceName",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PcieBBURemove": {
            "Reading": "<=/Controller_1.BatteryPresence",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 8,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SAS 3152",
            "Component": "#/Component_Battery"
        },
        "Event_PcieBBUInstall": {
            "Reading": "<=/Controller_1.BatteryPresence",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 7,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SAS 3152",
            "Component": "#/Component_Battery"
        },
        "Event_PcieCardReplaceMntr": {
            "Reading": "<=/Component_PCIeCard.ReplaceFlag",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg2": "#/Component_PCIeCard.PreviousSN",
            "DescArg3": "#/Component_PCIeCard.SerialNumber",
            "Component": "#/Component_PCIeCard"
        }
    }
}