        "ThresholdSensor_OpticalModuleTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_PCIeCard.Id",
            "EntityInstance": "<=/Entity_PCIeCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe%s OP Temp', $1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/OpticalModule_0.TemperatureCelsius;<=/OpticalModule_1.TemperatureCelsius;<=/OpticalModule_2.TemperatureCelsius;<=/OpticalModule_3.TemperatureCelsius |> expr($1 > $2 ? ($1 > $3 ? ($1 > $4 ? $1 : $4) : ($3 > $4 ? $3 : $4)) : ($2 > $3 ? ($2 > $4 ? $2 : $4) : ($3 > $4 ? $3 : $4)))",
            "ReadingStatus": "<=/OpticalModule_0.TemperatureCelsius;<=/OpticalModule_1.TemperatureCelsius;<=/OpticalModule_2.TemperatureCelsius;<=/OpticalModule_3.TemperatureCelsius;<=/OpticalModule_0.Presence;<=/OpticalModule_1.Presence;<=/OpticalModule_2.TemperatureCelsius;<=/OpticalModule_3.Presence |> expr($5 == 0 && $6 == 0 && $7 == 0 && $8 == 0 ? 32768 : ($1 > $2 ? ($1 > $3 ? ($1 > $4 ? $1 : $4) : ($3 > $4 ? $3 : $4)) : ($2 > $3 ? ($2 > $4 ? $2 : $4) : ($3 > $4 ? $3 : $4)))) |> expr($1 > 255 ? 3 : 0)"
        },
