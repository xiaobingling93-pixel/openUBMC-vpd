            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_PCIeCard.Id",
            "EntityInstance": "<=/Entity_PCIeCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe NIC%s Temp',$1)",
