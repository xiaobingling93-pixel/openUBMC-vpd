        "ThresholdSensor_OpticalModuleTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_SD100.Id",
            "EntityInstance": "<=/Entity_SD100.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe%s OP Temp',$1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/DPUCard_1.SFP1TemperatureCelsius;<=/DPUCard_1.SFP2TemperatureCelsius |> expr(($1 == 0 || $1 > 200) ? ($2 & 255) : (($2 == 0 || $2 > 200) ? ($1 & 255) : ($1 > $2 ? ($1 & 255) : ($2 & 255))))",
            "ReadingStatus": "<=/DPUCard_1.SFP1TemperatureCelsius;<=/DPUCard_1.SFP2TemperatureCelsius |> expr((($1 == 0 || $1 > 200) && ($2 == 0 || $2 > 200)) ? 2 : 0)"
