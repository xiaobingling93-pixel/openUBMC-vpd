            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_DPUCard.Name",
            "DescArg2": "#/Component_DPUCard.PreviousSN",
            "DescArg3": "#/Component_DPUCard.SerialNumber",
            "Component": "#/Component_DPUCard"
        },
        "Event_PCIeCardHeartBeatAbnormal": {
            "Reading": "<=/DPUCard_1.HeartBeatLoss",
            "OperatorId": 5,
            "Enabled": true,
            "DescArg1": "#/Component_DPUCard.Name",
            "Component": "#/Component_DPUCard"
        },
        "Event_PCIeCardUCE": {
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_DPUCard.Name",
            "DescArg4": "NA",
            "Component": "#/Component_DPUCard"
        },
        "Event_PCIeCardCE": {
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "OperatorId": 5,
