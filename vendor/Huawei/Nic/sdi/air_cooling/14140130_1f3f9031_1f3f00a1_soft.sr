        },
        "ThresholdSensor_PCIeCpuTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_SD100.Id",
            "EntityInstance": "<=/Entity_SD100.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe%s Cpu Temp',$1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/DPUCard_1.CPUTemperatureCelsius |> expr($1 & 255)",
            "ReadingStatus": "<=/DPUCard_1.CPUTemperatureCelsius |> expr(($1 == 0 || $1 > 200) ? 2 : 0)"
        },
        "ThresholdSensor_PCIeInletTemp": {
