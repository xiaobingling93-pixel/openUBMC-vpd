            "Reading": "<=/DPUCard_1.Inlet1TemperatureCelsius |> expr($1 & 255)",
            "ReadingStatus": "<=/DPUCard_1.Inlet1TemperatureCelsius |> expr(($1 == 0 || $1 > 200) ? 2 : 0)"
        },
        "ThresholdSensor_PCIeOutlet1Temp": {
