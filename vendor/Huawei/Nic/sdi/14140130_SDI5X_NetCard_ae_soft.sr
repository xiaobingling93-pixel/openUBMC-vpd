            "Type": 8,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Presence": 1,
            "Health": 0,
            "Function": "PCIe device(SDI)",
            "GroupId": 1,
            "PowerState": 1,
            "BoardId": "<=/Fru_NetworkAdapter.BoardId"
        },
        "Fru_NetworkAdapter": {
