{
    "FormatVersion": "3.00",
    "DataVersion": "3.01",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "Objects": {
        "FruData_RaidCard": {
            "FruId": 1,
            "FruDev": "#/Eeprom_Raid",
            "EepromWp": 0,
            "BoardPartNumber": "N/A",
            "BoardSerialNumber": "N/A",
            "StorageType": "EepromV2"
        },
        "Fru_PCIeCard": {
            "PcbVersion": ".A",
            "PowerState": 1,
            "Health": 0,
            "EepStatus": "<=/Eeprom_Raid.HealthStatus",
            "Type": 8,
            "FruDataId": "#/FruData_RaidCard"
        },
        "Component_Battery": {
            "FruId": 255,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Type": 8,
            "Name": "PCIe Card BBU",
            "Presence": 1,
            "Health": 0,
            "PowerState": 1
        },
        "Component_PCIeCard": {
            "FruId": 255,
            "Type": 8,
            "Health": 0,
            "PowerState": 1,
            "GroupId": 1,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Presence": 1,
            "ReplaceFlag": 0,
            "PreviousSN": "N/A",
            "SerialNumber": "<=/PCIeCard_1.SerialNumber",
            "PartNumber": "<=/FruData_RaidCard.BoardPartNumber",
            "Location": "<=/PCIeDevice_1.Position"
        },
        "DiscreteSensor_BBUStatus": {
            "EntityId": "<=/Entity_RaidCard.Id",
            "EntityInstance": "<=/Entity_RaidCard.Instance",
            "Initialization": 99,
            "Capabilities": 192,
            "SensorType": 41,
            "ReadingType": 111,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe%s Card BBU',$1)",
            "AssertMask": 7,
            "DeassertMask": 7,
            "DiscreteMask": 7,
            "DiscreteType": 0,
            "Unit": 192,
            "BaseUnit": 0,
            "ModifierUnit": 0,
            "DiscreteType": 0,
            "RecordSharing": 1,
            "Reading": 0
        },
        "DiscreteEvent_BBUStatus_0": {
            "Property": 0,
            "ListenType": 1,
            "EventData1": 0,
            "EventData2": 255,
            "EventData3": 255,
            "EventDir": "<=/Battery_1.HealthStatus |> expr(($1 & 1) == 0 ? 0 :1)",
            "Conversion": 0,
            "SensorObject": "#/DiscreteSensor_BBUStatus"
        },
        "DiscreteEvent_BBUStatus_1": {
            "Property": 0,
            "ListenType": 1,
            "EventData1": 1,
            "EventData2": 255,
            "EventData3": 255,
            "EventDir": "<=/Battery_1.HealthStatus |> expr(($1 & 254) == 0 ? 0 :1)",
            "Conversion": 0,
            "SensorObject": "#/DiscreteSensor_BBUStatus"
        },
        "DiscreteEvent_BBUStatus_2": {
            "Property": 0,
            "ListenType": 1,
            "EventData1": 2,
            "EventData2": 255,
            "EventData3": 255,
            "EventDir": "<=/Battery_1.State |> expr($1 == 1 ? 1 :0)",
            "Conversion": 0,
            "SensorObject": "#/DiscreteSensor_BBUStatus"
        },
        "ThresholdSensor_RaidCardTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_RaidCard.Id",
            "EntityInstance": "<=/Entity_RaidCard.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe RAID%s Temp',$1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/Controller_1.TemperatureCelsius",
            "ReadingStatus": "<=/Controller_1.TemperatureCelsius |> expr($1 == 32767 ? 1 : ($1 == 255 ? 2 : ($1 == 0 ? 3 : 0)))"
        },
        "ThresholdSensor_RaidDDRTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_RaidCard.Id",
            "EntityInstance": "<=/Entity_RaidCard.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('RAID%s DDR Temp',$1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/Scanner_Raid_Lm75.Value",
            "ReadingStatus": "<=/Scanner_Raid_Lm75.Status"
        },
        "Entity_RaidCard": {
            "Id": 11,
            "Instance": 96,
            "Name": "<=/PCIeDevice_1.SlotID |> string.format('PCIe Card%s (RAID)',$1)",
            "Presence": 1,
            "PowerState": 1
        },
        "Event_PCIeRaidComLossMntr": {
            "Reading": "<=/Controller_1.CommunicationLoss",
            "@Default": {
                "Reading": 0
            },
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/Component_PCIeCard.Instance",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeRAIDCardFault": {
            "Reading": "<=/Controller_1.FaultCode |> expr(($1 != 65535 && ($1 & 1990) != 0) ? 1 : 0)",
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_PCIeCard"
        },
        "Event_BatteryFault": {
            "Reading": "<=/Controller_1.BatteryFault",
            "OperatorId": 5,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_Battery",
            "InvalidReadingIgnore": 1,
            "InvalidReading": 255
        },
        "Event_PCIeBandWidth": {
            "Reading": "<=/PCIeDevice_1.BandwidthReduction",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(SP686C-M-16i 4G)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeLinkSpeed": {
            "Reading": "<=/PCIeDevice_1.LinkSpeedReduced",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(SP686C-M-16i 4G)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardUCE": {
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.DeviceName",
            "DescArg4": "NA",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardCE": {
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.DeviceName",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PcieBBURemove": {
            "Reading": "<=/Controller_1.BatteryPresence",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 8,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_Battery"
        },
        "Event_PcieBBUInstall": {
            "Reading": "<=/Controller_1.BatteryPresence",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 7,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_Battery"
        },
        "Event_PCIeRaidInitErr": {
            "Reading": "<=/Controller_1.FaultCodeByBios",
            "OperatorId": 6,
            "Enabled": true,
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "SP686C-M-16i 4G",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PcieCardReplaceMntr": {
            "Reading": "<=/Component_PCIeCard.ReplaceFlag",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg2": "#/Component_PCIeCard.PreviousSN",
            "DescArg3": "#/Component_PCIeCard.SerialNumber",
            "Component": "#/Component_PCIeCard"
        },
        "Event_OverTemp": {
            "Reading": "<=/Controller_1.TemperatureCelsius |> expr(($1 >= 255) ? 30 : $1)",
            "@Default": {
                "Condition": 105
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg4": "#/Event_OverTemp.Reading |> string.format('%s', $1)",
            "DescArg5": "#/ThresholdSensor_RaidCardTemp.UpperNoncritical"
        },
        "Event_TempFail": {
            "Reading": "<=/Controller_1.TemperatureAbnormal",
            "OperatorId": 5,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name"
        }
    }
}