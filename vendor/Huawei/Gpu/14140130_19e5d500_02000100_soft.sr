{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "Objects": {
        "Component_PCIeCard": {
            "Instance": "<=/PCIeDevice_1.SlotID",
            "UniqueId": "N/A",
            "FruId": 255,
            "BoardId": 65535,
            "Manufacturer": "Huawei",
            "Type": 8,
            "Presence": 1,
            "Health": 0,
            "PowerState": 1,
            "GroupId": 1,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "ReplaceFlag": 0,
            "PreviousSN": "",
            "SerialNumber": "<=/PCIeCard_1.SerialNumber"
        },
        "Event_PCIeCardUCE": {
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg4": "NA",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardCE": {
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PcieCardReplaceMntr": {
            "Reading": "<=/Component_PCIeCard.ReplaceFlag",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg2": "#/Component_PCIeCard.PreviousSN",
            "DescArg3": "#/Component_PCIeCard.SerialNumber",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeLinkSpeed": {
            "Reading": "<=/PCIeDevice_1.LinkSpeedReduced",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(Atlas 300I Pro Inference Card)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeBandWidth": {
            "Reading": "<=/PCIeDevice_1.BandwidthReduction",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(Atlas 300I Pro Inference Card)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_AiCoreOverTemp": {
            "Reading": "<=/NPUCard_1.Core0TemperatureCelsius |> expr(($1 >= 255) ? 40 : ($1 & 255))",
            "@Default": {
                "Reading": 40
            },
            "OperatorId": 4,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "3",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "AICORE",
            "DescArg4": "#/Event_AiCoreOverTemp.Reading",
            "DescArg5": "#/Event_AiCoreOverTemp.Condition"
        },
        "Event_OutletOverTemp": {
            "Reading": "<=/NPUCard_1.OutletTemperatureCelsius |> expr(($1 >= 255) ? 40 : ($1 & 255))",
            "@Default": {
                "Reading": 40
            },
            "OperatorId": 4,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "3",
            "DescArg1": "PCIe card",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "Outlet",
            "DescArg4": "#/Event_OutletOverTemp.Reading",
            "DescArg5": "#/Event_OutletOverTemp.Condition"
        },
        "Event_InletOverTemp": {
            "Reading": "<=/NPUCard_1.InletTemperatureCelsius |> expr(($1 >= 255) ? 40 : ($1 & 255))",
            "@Default": {
                "Reading": 40
            },
            "OperatorId": 4,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "3",
            "DescArg1": "PCIe card",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "Inlet",
            "DescArg4": "#/Event_InletOverTemp.Reading",
            "DescArg5": "#/Event_InletOverTemp.Condition"
        },
        "Event_AirTempFail": {
            "Reading": "<=/NPUCard_1.FaultState |> expr(($1 & 268435456) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Component": "#/Component_PCIeCard",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "inlet or outlet",
            "DescArg4": "#/NPUCard_1.FaultCode"
        }
    }
}