/dev/shm/log/web/access_log{
        su root root
        size = 200k
        nocompress
        copytruncate
        prerotate
                /etc/prerotate.sh "$1"
        endscript
        postrotate
                /bin/kill -HUP `cat /var/run/syslogd.pid 2> /dev/null` 2> /dev/null || true
        endscript
        rotate 1
        lastaction
                chmod 0400 /dev/shm/log/web/access_log.1 2> /dev/null || true
        endscript
}
