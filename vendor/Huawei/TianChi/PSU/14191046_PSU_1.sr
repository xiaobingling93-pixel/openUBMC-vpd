        "Scanner_PsuOPOKStatus": {
            "Chip": "#/Smc_ExpBoardSMC",
            "Offset": 603981056,
            "Size": 2,
            "Mask": "${Slot} |> expr($1 == 1 ? 4 : 1024)",
            "Type": 0,
            "Value": 0,
            "Period": 1000,
            "Debounce": "#/ContBin_OPOK"
        },
        "ContBin_OPOK": {
            "NumH": 1,
	        "NumL": 5,
            "DefaultValue": 1
        },
        "Smc_ExpBoardSMC": {
            "Address": 96,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 0,
            "ReadTmout": 0
        },
        "Fru_Ps": {
            "PcbId": 254,
            "FruId": 1,
            "FruName": "PSU${Slot}",
            "ConnectorGroupId": "${GroupId}",
            "BoardId": 65535
        },
        "Event_VoutOvFault": {
            "EventKeyId": "PSU.PSUOutputOverVoltage",
            "Condition": 128,
            "LedFaultCode": "P$$"
        },
        "Event_PSOverTemp": {
            "EventKeyId": "PSU.PSUOverTemp",
            "Condition": 128,
            "LedFaultCode": "P$$"
        },
        "Event_IoutOcFault": {
