            "DeviceLocator": "PSU${Slot}",
            "Position": "EXU",
            "EnvTemperatureCelsius": 0,
            "SerialNumber": "",
            "OutputState": "<=/Scanner_PsuOPOKStatus.Value",
            "DeepSleepEnabled": 0,
            "OutputPowerWatts": 0,
            "InputVoltageFault": 32768,
            "OutputVoltageFault": 0,
            "OutputCurrentFault": 0,
