    "Unit": {
        "Type": "PSU",
        "Name": "OnePower_0"
    },
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2c_2"
            ]
        },
        "I2c_2": {
            "Chips": [
                "Smc_ExpBoardSMC"
            ]
        }
    },
    "Objects": {
