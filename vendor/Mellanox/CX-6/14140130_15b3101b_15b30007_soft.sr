{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "Objects": {
        "Component_Port1": {
            "FruId": 255,
            "Instance": 1,
            "Type": 41,
            "Name": "Port1",
            "Presence": 1,
            "Health": 0,
            "PowerState": 1
        },
        "Component_PCIeCard": {
            "FruId": 255,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Type": 8,
            "BoardId": 85,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Location": "<=/PCIeDevice_1.Position",
            "Manufacturer": "Mellanox",
            "PartNumber": "",
            "UniqueId": "N/A",
            "Presence": 1,
            "Health": 0,
            "Function": "PCIe device",
            "GroupId": 1,
            "PowerState": 1,
            "SerialNumber": "",
            "NodeId": "<=/PCIeDevice_1.SlotID"
        },
        "ThresholdSensor_Temp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_PCIeCard.Id",
            "EntityInstance": "<=/Entity_PCIeCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe NIC%s Temp',$1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/Scanner_IBTemp.Value",
            "ReadingStatus": "<=/Scanner_IBTemp.Status"
        },
        "ThresholdSensor_OpticalModuleTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_PCIeCard.Id",
            "EntityInstance": "<=/Entity_PCIeCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('PCIe%s OP Temp', $1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/OpticalModule_0.TemperatureCelsius |> expr(($1 >= 255) ? 0 : $1)",
            "ReadingStatus": "<=/OpticalModule_0.TemperatureCelsius;<=/OpticalModule_0.Presence |> expr($2 == 0 ? 3 : ($1 >= 255 ? 3 : 0))"
        },
        "Entity_PCIeCard": {
            "Id": 11,
            "Name": "PCIeCard",
            "Instance": 101,
            "PowerState": 1,
            "Presence": 1
        },
        "Event_PcieCardReplaceMntr": {
            "Reading": "<=/Component_PCIeCard.ReplaceFlag",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg2": "#/Component_PCIeCard.PreviousSN",
            "DescArg3": "#/Component_PCIeCard.SerialNumber",
            "Component": "#/Component_PCIeCard"
        },
        "Event_OverTemp": {
            "Reading": "<=/ThresholdSensor_Temp.Reading |> expr(($1 >= 128) ? ($1 - 256) : $1)",
            "@Default": {
                "Condition": 105
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "IBCard",
            "DescArg4": "#/Event_OverTemp.Reading",
            "DescArg5": "#/ThresholdSensor_Temp.UpperNoncritical"
        },
        "Event_OpticalModule_OverTemp": {
            "Hysteresis": "<=/ThresholdSensor_OpticalModuleTemp.PositiveHysteresis",
            "Reading": "<=/OpticalModule_0.TemperatureCelsius |> expr(($1 >= 255) ? 0 : $1)",
            "@Default": {
                "Condition": 75
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg4": "#/Event_OpticalModule_OverTemp.Reading",
            "DescArg5": "#/ThresholdSensor_OpticalModuleTemp.UpperNoncritical"
        },
        "Event_TempFail": {
            "Reading": "<=/NetworkAdapter_1.TemperatureStatus",
            "OperatorId": 5,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "IBCard Chip"
        },
        "Event_Port1LinkDown": {
            "Reading": "<=/NetworkPort_0.LinkStatusNumeric",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 8,
            "Enabled": true,
            "DescArg1": "#/PCIeCard_1.DeviceName",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
        "Event_OM0VAMntr": {
            "Reading": "<=/OpticalModule_0.FaultState;<=/OpticalModule_0.SupplyVoltage;<=/OpticalModule_0.VoltageLowerThresholdCritical;<=/OpticalModule_0.VoltageUpperThresholdCritical |> expr((($1 & 16 != 0) && ($2 != 65535) && ($3 != 65535) && ($2 < $3)) || (($1 & 32 != 0) && ($2 != 65535) && ($4 != 65535) && ($2 > $4)))",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "DescArg4": "#/OpticalModule_0.SupplyVoltage",
            "Component": "#/Component_Port1"
        },
        "Event_OM0PowerAlarm": {
            "Reading": "<=/OpticalModule_0.PowerState",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
        "Event_OM0SpeedMatch": {
            "Reading": "<=/OpticalModule_0.IsSupportedType",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
        "Event_PCIeBandWidth": {
            "Reading": "<=/PCIeDevice_1.BandwidthReduction",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(MCX653105A-HDAT)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeLinkSpeed": {
            "Reading": "<=/PCIeDevice_1.LinkSpeedReduced",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(MCX653105A-HDAT)",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardUCE": {
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg4": "NA",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardCE": {
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "Component": "#/Component_PCIeCard"
        },
        "Event_Port0BWUsageMntr": {
            "Reading": "<=/NetworkPort_0.BandwidthUsagePercent",
            "@Default": {
                "Condition": 100
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "1,3",
            "DescArg1": "#/PCIeDevice_1.DeviceName",
            "DescArg3": "Port 1",
            "DescArg4": "#/Event_Port0BWUsageMntr.Reading",
            "DescArg5": "#/Event_Port0BWUsageMntr.Condition"
        }
    }
}