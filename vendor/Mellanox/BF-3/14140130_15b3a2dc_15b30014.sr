{
    "FormatVersion": "3.00",
    "DataVersion": "3.02",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2cMux_Chan"
            ]
        },
        "I2cMux_Chan": {
            "Chips": [
                "Chip_TempChip",
                "Eeprom_BF3"
            ]
        }
    },
    "Objects": {
        "Eeprom_BF3": {
            "AddrWidth": 1,
            "Address": 160,
            "HealthStatus": 0,
            "OffsetWidth": 2,
            "ReadTmout": 100,
            "RwBlockSize": 32,
            "WriteInterval": 20,
            "WriteTmout": 100
        },
        "Chip_TempChip": {
            "Address": 62,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
        "Scanner_NICTemp": {
            "Chip": "#/Chip_TempChip",
            "Size": 1,
            "Offset": 1,
            "Mask": 65535,
            "Period": 1000,
            "Debounce": "#/MidAvg_NICTemp"
        },
        "MidAvg_NICTemp": {
            "WindowSize": 4,
            "DefaultValue": 20,
            "IsSigned": true
        },
        "ThresholdSensor_Temp": {
            "AssertMask": 128,
            "DeassertMask": 28800,
            "ReadingMask": 2056,
            "Linearization": 0,
            "M": 100,
            "RBExp": 224,
            "UpperNoncritical": 94,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "Event_OverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Condition": "<=/ThresholdSensor_Temp.UpperNoncritical",
            "Hysteresis": "<=/ThresholdSensor_Temp.PositiveHysteresis"
        },
        "Event_TempFail": {
            "EventKeyId": "PcieCard.PCIeCardTempFail",
            "Condition": 1
        },
        "Event_OM0OverTempInfo": {
            "EventKeyId": "PcieCard.PCIeCardOMOverTemp",
            "Condition": 75,
            "LedFaultCode": "q$$"
        },
        "Event_OM1OverTempInfo": {
            "EventKeyId": "PcieCard.PCIeCardOMOverTemp",
            "Condition": 75,
            "LedFaultCode": "q$$"
        },
        "ThresholdSensor_OpticalModuleTemp": {
