        "CoolingRequirement_1_52": {
            "RequirementId": "${Slot} |> expr((52 << 8) | $1)",
            "Description": "BF3网卡芯片调速",
            "MonitoringStatus": "<=/Scanner_NICTemp.Status",
            "MonitoringValue": "<=/Scanner_NICTemp.Value",
            "FailedValue": 80,
            "TargetTemperatureCelsius": 82,
            "MaxAllowedTemperatureCelsius": 90,
            "TargetTemperatureRangeCelsius": [],
            "SmartCoolingTargetTemperature": [],
            "CustomSupported": false,
            "ActiveInStandby": true,
            "CustomTargetTemperatureCelsius": 255,
            "Enabled": "<=/CoolingRequirement_1_55.MonitoringStatus |> expr($1 == 0 ? true : false)",
            "SensorName": "#/ThresholdSensor_Temp.SensorName"
        },
        "CoolingRequirement_1_54": {
            "RequirementId": "${Slot} |> expr((54 << 8) | $1)",
            "Description": "BF3网卡网卡芯片调速（光模块异常）",
            "MonitoringStatus": "<=/Scanner_NICTemp.Status",
            "MonitoringValue": "<=/Scanner_NICTemp.Value",
            "FailedValue": 80,
            "TargetTemperatureCelsius": 75,
            "MaxAllowedTemperatureCelsius": 90,
            "TargetTemperatureRangeCelsius": [],
            "SmartCoolingTargetTemperature": [],
            "CustomSupported": false,
            "CustomTargetTemperatureCelsius": 255,
            "Enabled": "<=/CoolingRequirement_1_55.MonitoringStatus |> expr($1 ~= 0 ? true : false)",
            "SensorName": "#/ThresholdSensor_Temp.SensorName"
        },
        "CoolingRequirement_1_55": {
            "RequirementId": "${Slot} |> expr((55 << 8) | $1)",
            "Description": "BF3网卡光模块温度调速",
            "MonitoringStatus": "<=/OpticalModule_1.Presence; <=/OpticalModule_2.Presence; <=/OpticalModule_1.TemperatureCelsius; <=/OpticalModule_2.TemperatureCelsius |> expr((($1 == 1 && $3 >= 255) || ($2 == 1 && $4 >= 255)) ? 1 : 0)",
            "MonitoringValue": "<=/OpticalModule_1.Presence; <=/OpticalModule_2.Presence; <=/OpticalModule_1.TemperatureCelsius; <=/OpticalModule_2.TemperatureCelsius  |> expr($3 >= $4 ? ($1 == 1 ? $3 : $4) : ($2 == 1 ? $4 : $3))",
            "TargetTemperatureCelsius": 60,
            "MaxAllowedTemperatureCelsius": 75,
            "FailedValue": 0,
            "TargetTemperatureRangeCelsius": [],
            "SmartCoolingTargetTemperature": [60, 55, 65],
            "CustomSupported": false,
            "CustomTargetTemperatureCelsius": 255,
            "Enabled": "<=/OpticalModule_1.Presence; <=/OpticalModule_2.Presence |> expr(($1 == 1 || $2 == 1) ? true : false)",
            "SensorName": "#/ThresholdSensor_OpticalModuleTemp.SensorName"
        }
    }
