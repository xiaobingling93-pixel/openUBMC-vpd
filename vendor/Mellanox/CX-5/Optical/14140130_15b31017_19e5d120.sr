            "Chip": "#/Pca9555_PCIe",
            "Offset": 0,
            "Size": 1,
            "Mask": 255,
            "Type": 0,
            "Value": 0
        },
        "Scanner_IBTemp": {
            "Chip": "#/Chip_TempChip",
            "Size": 1,
            "Offset": 1,
            "Mask": 65535,
            "Period": 1000,
            "Type": 0,
            "Debounce": "#/MidAvg_IBTemp"
        },
        "MidAvg_IBTemp": {
            "WindowSize": 4,
            "DefaultValue": 20,
            "IsSigned": true
        },
        "ThresholdSensor_Temp": {
            "AssertMask": 128,
            "DeassertMask": 28800,
            "ReadingMask": 2056,
            "Linearization": 0,
            "M": 100,
            "RBExp": 224,
            "UpperNoncritical": 105,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "CoolingRequirement_1_59": {
            "RequirementId": "${Slot} |> expr((59 << 8) | $1)",
            "Description": "IB卡芯片调速",
            "MonitoringStatus": "<=/Scanner_IBTemp.Status",
            "MonitoringValue": "<=/Scanner_IBTemp.Value",
            "FailedValue": 80,
            "TargetTemperatureCelsius": 90,
            "MaxAllowedTemperatureCelsius": 102,
            "TargetTemperatureRangeCelsius": [],
            "ThresholdValue": [],
            "AlarmSpeed": [],
            "SmartCoolingTargetTemperature": [],
