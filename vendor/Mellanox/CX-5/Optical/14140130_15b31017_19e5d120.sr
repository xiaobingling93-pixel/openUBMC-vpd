        "Chip_TempChip": {
            "Address": 62,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
        "Pca9555_PCIe": {
            "OffsetWidth": 1,
            "AddrWidth": 1,
            "Address": 64,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
