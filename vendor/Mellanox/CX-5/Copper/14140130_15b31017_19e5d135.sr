            "AssertMask": 128,
            "DeassertMask": 28800,
            "ReadingMask": 2056,
            "Linearization": 0,
            "M": 100,
            "RBExp": 224,
            "UpperNoncritical": 105,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "Event_NicOverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Reading": "<=/Scanner_NicTemp.Value |> expr(($1 >= 128) ? ($1 - 256) : $1)",
            "Condition": "<=/ThresholdSensor_NicTemp.UpperNoncritical",
            "@Default": {
                "Condition": 105
            },
            "OperatorId": 4,
            "Hysteresis": "<=/ThresholdSensor_NicTemp.PositiveHysteresis",
            "Enabled": true,
