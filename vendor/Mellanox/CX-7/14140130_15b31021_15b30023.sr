            "StorageType": "EepromStandard"
        },
        "Fru_CX7": {
            "PcbVersion": ".A",
            "PowerState": 1,
            "Health": 0,
            "EepStatus": "<=/Eeprom_CX7.HealthStatus",
            "Type": 8,
            "FruId": 1,
            "FruName": "MCX75310AAS-NEAT",
            "FruDataId": "#/FruData_CX7"
        },
        "Component_PCIeCard": {
            "FruId": 255,
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Type": 8,
            "BoardId": 65535,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Location": "<=/PCIeDevice_1.Position",
            "Manufacturer": "Mellanox",
