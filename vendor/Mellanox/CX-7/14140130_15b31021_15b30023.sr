            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/OpticalModule_1.TemperatureCelsius",
            "ReadingStatus": "<=/OpticalModule_1.TemperatureCelsius;<=/OpticalModule_1.Presence |> expr(($2 == 0) ? 32768 : $1) |> expr($1 >= 255 ? 3 : 0)"
        },
        "Entity_PCIeCard": {
            "Id": 11,
            "Name": "PCIeCard",
            "Instance": 101,
            "PowerState": 1,
            "Presence": 1
        },
