        "Event_OM0PowerAlarm": {
            "Reading": "<=/OpticalModule_0.PowerState",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
        "Event_OM1PowerAlarm": {
            "Reading": "<=/OpticalModule_1.PowerState",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 2",
            "Component": "#/Component_Port2"
        },
        "Event_OM0SpeedMatch": {
            "Reading": "<=/OpticalModule_0.IsSupportedType",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
        "Event_OM1SpeedMatch": {
            "Reading": "<=/OpticalModule_1.IsSupportedType",
