            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 2",
            "Component": "#/Component_Port2"
        },
        "Event_OM0VAMntr": {
            "Reading": "<=/OpticalModule_0.FaultState;<=/OpticalModule_0.SupplyVoltage;<=/OpticalModule_0.VoltageLowerThresholdCritical;<=/OpticalModule_0.VoltageUpperThresholdCritical |> expr((($1 & 16 != 0) && ($2 != 65536) && ($3 != 65536) && ($2 < $3)) || (($1 & 32 != 0) && ($2 != 65536) && ($4 != 65536) && ($2 > $4)))",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 1",
            "DescArg4": "#/OpticalModule_0.SupplyVoltage",
            "Component": "#/Component_Port1"
        },
        "Event_OM1VAMntr": {
            "Reading": "<=/OpticalModule_1.FaultState;<=/OpticalModule_1.SupplyVoltage;<=/OpticalModule_1.VoltageLowerThresholdCritical;<=/OpticalModule_1.VoltageUpperThresholdCritical |> expr((($1 & 16 != 0) && ($2 != 65536) && ($3 != 65536) && ($2 < $3)) || (($1 & 32 != 0) && ($2 != 65536) && ($4 != 65536) && ($2 > $4)))",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_PCIeCard.Name",
            "DescArg3": "Port 2",
            "DescArg4": "#/OpticalModule_1.SupplyVoltage",
            "Component": "#/Component_Port2"
        },
        "Event_Port1LinkDown": {
            "Reading": "<=/NetworkPort_0.LinkStatusNumeric",
            "@Default": {
                "Reading": 255
            },
            "OperatorId": 8,
            "Enabled": true,
            "DescArg1": "#/PCIeCard_1.DeviceName",
            "DescArg3": "Port 1",
            "Component": "#/Component_Port1"
        },
