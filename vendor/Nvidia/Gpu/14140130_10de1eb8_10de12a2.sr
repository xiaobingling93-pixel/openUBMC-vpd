{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "Unit": {
        "Type": "PCIeCard",
        "Name": "PCIeCard_1"
    },
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2cMux_Chan"
            ]
        },
        "I2cMux_Chan": {
            "Chips": [
                "Chip_TempChip"
            ]
        }
    },
    "Objects": {
        "Chip_TempChip": {
            "Address": 159,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
        "Scanner_GPUTemp": {
            "Chip": "#/Chip_TempChip",
            "Size": 1,
            "Offset": 0,
            "Mask": 255,
            "Period": 1000,
            "Debounce": "#/MidAvg_GPUTemp",
            "Type": 0
        },
        "MidAvg_GPUTemp": {
            "WindowSize": 4,
            "DefaultValue": 20,
            "IsSigned": true
        },
        "GPU_1": {
            "SystemId": 1,
            "Id": 1,
            "Name": "Tesla T4",
            "Presence": 1,
            "Manufacturer": "Nvidia",
            "Model": "Tesla T4",
            "SN": "",
            "SocketDesignation": "1",
            "Position": "<=/PCIeDevice_1.Position",
            "ProcessorType": "2",
            "Health": "#/Component_Tesla.Health",
            "Slot": "<=/PCIeDevice_1.SlotID",
            "VendorID": 4318,
            "DeviceID": 7864,
            "SubVendorID": 4318,
            "SubDeviceID": 4770,
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "RefChip": "#/Chip_TempChip",
            "SerialNumber": "#/PCIeCard_1.SerialNumber",
            "CardFirmwareVersion": "#/PCIeCard_1.FirmwareVersion",
            "CardPartNumber": "02570029",
            "PrimaryGPUTemperatureCelsius": "<=/Scanner_GPUTemp.Value"
        },
        "Entity_GPUCard": {
            "Id": 11,
            "Name": "GPUCard",
            "PowerState": 1,
            "Presence": 1,
            "Instance": 101
        },
        "ThresholdSensor_GpuPower": {
            "EntityId": "<=/Entity_GPUCard.Id",
            "EntityInstance": "<=/Entity_GPUCard.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 11,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('GPU%s Power',$1)",
            "Unit": 0,
            "BaseUnit": 6,
            "NominalReading": 0,
			"MaximumReading": 255,
			"AssertMask": 0,
			"DeassertMask": 0,
			"ReadingMask": 0,
			"M": 12,
			"RBExp": 240,
			"Analog": 1,
            "Reading": "<=/GPU_1.PowerWatts |> expr($1 // 12)",
            "ReadingStatus": "<=/GPU_1.PowerWatts |> expr(($1 == 0) ? 2 : 0)",
            "SensorNumber": 255
        },
        "PCIeDevice_1": {
            "Segment": 1,
            "DeviceName": "PCIe Card $ (Tesla T4)",
            "DiagnosticFault": 0,
            "PredictiveFault": 0,
            "FunctionClass": 3,
            "Position": "",
            "Container": "${Container}",
            "GroupPosition": "PCIeDevice_${GroupPosition}",
            "BandwidthReduction": 0,
            "CorrectableError": 0,
            "UncorrectableError": 0,
            "FatalError": 0,
            "LinkSpeedReduced": 0,
            "DeviceType": 8,
            "PCIeDeviceType": "SingleFunction",
            "SlotType": "FullLength",
            "FunctionProtocol": "PCIe",
            "FunctionType": "Physical"
        },
        "PCIeCard_1": {
            "SlotID": "<=/PCIeDevice_1.SlotID",
            "NodeID": "<=/PCIeDevice_1.SlotID |> string.format('PCIeCard%s',$1)",
            "Name": "Tesla T4",
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "BoardName": "Tesla T4",
            "Model": "Tesla T4",
            "Description": "TU104GL [Tesla T4]",
            "FunctionClass": 3,
            "VendorID": 4318,
            "DeviceID": 7864,
            "SubVendorID": 4318,
            "SubDeviceID": 4770,
            "Position": "<=/PCIeDevice_1.Position",
            "LaneOwner": "<=/PCIeDevice_1.SocketID",
            "FirmwareVersion": "N/A",
            "Manufacturer": "Nvidia",
            "PartNumber": "02570029",
            "Protocol": "",
            "MaxFrameLen": 64,
            "LinkSpeed": "N/A",
            "LinkSpeedCapability": "N/A",
            "PcbVersion": "N/A",
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "SerialNumber": "",
            "DevFunction": "<=/PCIeDevice_1.DevFunction"
        },
        "Event_PCIeCardUCE": {
            "EventKeyId": "PCIeCard.PCIeCardUncorrectableErr",
            "Condition": 1,
            "LedFaultCode": "q$$"
        },
        "Event_PCIeCardCE": {
            "EventKeyId": "PCIeCard.PCIeCardCEHardFailure",
            "Condition": 1,
            "LedFaultCode": "q$$"
        },
        "Event_PcieCardReplaceMntr": {
            "EventKeyId": "PcieCard.PcieCardReplace",
            "Condition": 1
        },
        "ThresholdSensor_GPUTemp": {
            "AssertMask": 128,
            "DeassertMask": 28800,
            "ReadingMask": 2056,
            "Linearization": 0,
            "M": 100,
            "RBExp": 224,
            "UpperNoncritical": 93,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "CoolingRequirement_1_58": {
            "RequirementId": "${Slot} |> expr((58 << 8) | $1)",
            "MonitoringStatus": "<=/Scanner_GPUTemp.Value |> expr($1 >= 255 ? 1 : 0)",
            "MonitoringValue": "<=/Scanner_GPUTemp.Value |> expr($1 >= 255 ? 30 : ($1 & 255))",
            "FailedValue": 80,
            "TargetTemperatureCelsius": 73,
            "MaxAllowedTemperatureCelsius": 79,
            "SensorName": "#/ThresholdSensor_GPUTemp.SensorName"
        },
        "Event_OverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Condition": "<=/ThresholdSensor_GPUTemp.UpperNoncritical",
            "Hysteresis": "<=/ThresholdSensor_GPUTemp.PositiveHysteresis"
        },
        "Event_TempFail": {
            "EventKeyId": "PcieCard.PCIeCardTempFail",
            "Condition": 1
        },
        "Event_PCIeBandWidth": {
            "EventKeyId": "PCIeCard.PCIeCardBandWidthDecreased",
            "Condition": 1
        },
        "Event_PCIeLinkSpeed": {
            "EventKeyId": "PCIeCard.PCIeCardLinkSpeedReduced",
            "Condition": 1
        }
