            "Manufacturer": "Iluvatar Technologies",
            "PartNumber": "",
            "PcbVersion": "N/A",
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "SerialNumber": "<=/GPU_1.SN",
            "CardManufacturer": "Iluvatar Technologies",
            "CardModel": "BI-V150"
        },
        "BoardPCIeCard_1": {
            "Slot": "<=/PCIeDevice_1.SlotID",
            "UID": "N/A",
            "Name": "BI-V150",
            "Manufacturer": "Iluvatar Technologies",
            "Type": "PCIeCard",
            "Description": "BI-V150",
            "PartNumber": "",
            "PcbID": 0,
            "LogicVersion": "N/A",
            "SRVersion": "",
            "BoardType": "BoardPCIeCard",
            "Number": 1,
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "Position": "<=/PCIeDevice_1.Position",
            "BoardNodeId": "<=/PCIeDevice_1.DeviceName",
            "FruID": 255
        },
        "Entity_GPUCard": {
            "Id": 11,
            "Name": "GPUCard",
            "PowerState": 1,
            "Presence": 1,
            "Instance": 101
        },
        "ThresholdSensor_V150GPUBoardTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_GPUCard.Id",
            "EntityInstance": "<=/Entity_GPUCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "V150_${Slot}_B_Temp",
            "Unit": 0,
            "BaseUnit": 1,
            "NominalReading": 25,
			"MaximumReading": 127,
			"MinimumReading": 128,
			"AssertMask": 128,
			"DeassertMask": 28800,
			"ReadingMask": 2056,
			"M": 100,
			"RBExp": 224,
			"Analog": 1,
            "Reading": "<=/Scanner_GPUTemp.Value |> expr(($1 // 16777216) & 255)",
            "ReadingStatus": 0,
            "SensorNumber": 255,
            "UpperNoncritical": 85,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "ThresholdSensor_V150GPUChipTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_GPUCard.Id",
            "EntityInstance": "<=/Entity_GPUCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "V150_${Slot}_C_Temp",
            "Unit": 0,
            "BaseUnit": 1,
            "NominalReading": 25,
			"MaximumReading": 127,
			"MinimumReading": 128,
			"AssertMask": 128,
			"DeassertMask": 28800,
			"ReadingMask": 2056,
			"M": 100,
			"RBExp": 224,
			"Analog": 1,
            "Reading": "<=/Scanner_GPUTemp.Value |> expr(($1 // 65536) & 255)",
            "ReadingStatus": 0,
            "SensorNumber": 255,
            "UpperNoncritical": 89,
            "PositiveHysteresis": 2,
            "NegativeHysteresis": 2
        },
        "ThresholdSensor_GpuPower": {
            "OwnerId": 48,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_GPUCard.Id",
            "EntityInstance": "<=/Entity_GPUCard.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 11,
            "ReadingType": 1,
            "SensorName": "V150_${Slot}_Power",
            "Unit": 0,
            "BaseUnit": 6,
            "NominalReading": 0,
            "MaximumReading": 255,
            "MinimumReading": 0,
            "AssertMask": 0,
            "DeassertMask": 0,
            "ReadingMask": 0,
            "M": 1,
            "RBExp": 0,
            "Analog": 1,
            "Reading": "<=/Scanner_GPUPower.Value |> expr((($1 // 65535) & 65535) / 1000)",
            "ReadingStatus": "<=/Scanner_GPUPower.Value |> expr(((($1 // 65535) & 65535) == 32768 || (($1 // 65535) & 65535) == 16384) ? 3 : 0)",
            "SensorNumber": 255
        },
        "Component_PCIeCard": {
            "FruId": 255,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Instance": "<=/PCIeDevice_1.SlotID",
            "BoardId": 65535,
            "Type": 8,
            "Presence": 1,
            "Health": 0,
            "PowerState": "<=/::FruCtrl_1_0.PowerState |> string.cmp($1, 'ON') |> expr($1 ? 1 : 0)",
            "UniqueId": "N/A",
            "Manufacturer": "Iluvatar Technologies",
            "ReplaceFlag": 0,
            "PreviousSN": "",
            "SerialNumber": "<=/PCIeCard_1.SerialNumber",
            "GroupId": 1
        },
        "Event_ChipOverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Condition": "<=/ThresholdSensor_V150GPUChipTemp.UpperNoncritical",
            "Hysteresis": "<=/ThresholdSensor_V150GPUChipTemp.PositiveHysteresis",
            "Reading": "<=/Scanner_GPUTemp.Value |> expr((($1 // 65536) & 255 >= 128) ? (-(255 - (($1 // 65536) & 255) + 1)) :(($1 // 65536) & 255))",
            "@Default": {
                "Condition": 89
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "V150 GPU CHIP",
            "DescArg4": "#/Event_ChipOverTemp.Reading",
            "DescArg5": "#/Event_ChipOverTemp.Condition"
        },
        "Event_CardOverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Condition": "<=/ThresholdSensor_V150GPUBoardTemp.UpperNoncritical",
            "Hysteresis": "<=/ThresholdSensor_V150GPUBoardTemp.PositiveHysteresis",
            "Reading": "<=/Scanner_GPUTemp.Value |> expr((($1 // 16777216) & 255 >= 128) ? (-(255 - (($1 // 16777216) & 255) + 1)) :(($1 // 16777216) & 255))",
            "@Default": {
                "Condition": 85
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg3": "V150 GPU",
            "DescArg4": "#/Event_CardOverTemp.Reading",
            "DescArg5": "#/Event_CardOverTemp.Condition"
        },
        "Event_CardTempFail": {
            "EventKeyId": "PcieCard.PCIeCardTempFail",
            "Condition": 1,
            "Reading": "<=/Scanner_GPUTemp.Status;<=/Scanner_GPUTemp.Value |> expr($1 == 0 ? (($2 // 16777216) == 32768 ? 1 : 0) : 0)",
            "OperatorId": 5,
            "Enabled": true,
            "Component": "#/Component_PCIeCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name"
        },
        "Event_PCIeCardUCE": {
            "EventKeyId": "PCIeCard.PCIeCardUncorrectableErr",
            "Condition": 1,
            "LedFaultCode": "q$$",
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "OperatorId": 5,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_PCIeCard.Name",
            "DescArg4": "NA",
            "Component": "#/Component_PCIeCard"
        },
        "Event_PCIeCardCE": {
            "EventKeyId": "PCIeCard.PCIeCardCEHardFailure",
