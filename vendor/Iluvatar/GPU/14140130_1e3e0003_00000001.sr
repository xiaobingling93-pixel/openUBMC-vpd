{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2cMux_Chan"
            ]
        },
        "I2cMux_Chan": {
            "Chips": [
                "Chip_Iluvatar_1"
            ]
        }
    },
    "Objects": {
        "Chip_Iluvatar_1": {
            "Address": 208,
            "AddrWidth": 1,
            "OffsetWidth": 1,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "HealthStatus": 0
        },
        "MidAvg_GPUTemp": {
            "WindowSize": 6,
            "DefaultValue": 0,
            "IsSigned": true
        },
        "Scanner_GPUTemp": {
            "Chip": "#/Chip_Iluvatar_1",
            "Size": 2,
            "Offset": 3,
            "Mask": 65535,
            "Period": 1000,
            "Debounce": "#/MidAvg_GPUTemp",
            "Type": 0,
            "ScanEnabled": "<=/::FruCtrl_1_0.PowerState |> string.cmp($1, 'ON') |> expr($1 ? 1 : 0)"
        },
        "Scanner_GPUPower": {
            "Chip": "#/Chip_Iluvatar_1",
            "Size": 2,
            "Offset": 15,
            "Mask": 65535,
            "Period": 1000,
            "Debounce": "None",
            "Type": 0,
            "ScanEnabled": "<=/::FruCtrl_1_0.PowerState |> string.cmp($1, 'ON') |> expr($1 ? 1 : 0)"
        },
        "GPU_1": {
            "SystemId": 1,
            "Id": 1,
            "Name": "BI-V150",
            "Presence": 1,
            "Manufacturer": "Iluvatar Technologies",
            "Model": "BI-V150",
            "SN": "",
            "SocketDesignation": "1",
            "Position": "PCIe Riser${Slot}",
            "ProcessorType": "2",
            "Health": "#/Component_PCIeCard.Health",
            "Slot": "<=/PCIeDevice_1.SlotID",
            "VendorID": 7742,
            "DeviceID": 3,
            "SubVendorID": 0,
            "SubDeviceID": 1,
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "RefChip": "#/Chip_Iluvatar_1",
            "PrimaryGPUTemperatureCelsius": "<=/Scanner_GPUTemp.Value |> expr(($1 // 16777216) & 255)"
        },
        "PCIeDevice_1": {
            "DeviceName": "PCIe Card $ (BI-V150)",
            "DeviceType": 8,
            "FunctionClass": 3,
            "Container": "${Container}",
            "GroupPosition": "PCIeDevice_${GroupPosition}",
            "BandwidthReduction": 0,
            "CorrectableError": 0,
            "UncorrectableError": 0,
            "FatalError": 0,
            "LinkSpeedReduced": 0,
            "PCIeDeviceType": "SingleFunction",
            "SlotType": "FullLength",
            "FunctionProtocol": "PCIe",
            "FunctionType": "Physical"
        },
        "PCIeCard_1": {
            "SlotID": "<=/PCIeDevice_1.SlotID",
            "NodeID": "<=/PCIeDevice_1.SlotID |> string.format('PCIeCard%s',$1)",
            "Name": "BI-V150",
            "Model": "BI-V150",
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "Description": "BI-V150",
            "FunctionClass": 3,
            "VendorID": 7742,
            "DeviceID": 3,
            "SubVendorID": 0,
            "SubDeviceID": 1,
            "Position": "<=/PCIeDevice_1.Position",
