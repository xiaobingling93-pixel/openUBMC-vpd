{
    "FormatVersion": "1.00",
    "DataVersion": "1.01",
    "ManagementTopology": {
        "Anchor": {
            "Buses": [
                "I2c_1"
            ]
        },
        "I2c_1": {
            "Chips": [
                "Chip_CPLD",
                "Chip_BMC",
                "Chip_FRU"
            ]
        }
    },
    "Objects": {
        "Chip_CPLD": {
            "OffsetWidth": 2,
            "AddrWidth": 1,
            "Address": 38,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "RwBlockSize": 32,
            "WriteInterval": 20,
            "HealthStatus": 0
        },
        "Chip_BMC": {
            "OffsetWidth": 2,
            "AddrWidth": 1,
            "Address": 32,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "RwBlockSize": 32,
            "WriteInterval": 20,
            "HealthStatus": 0
        },
        "Chip_FRU": {
            "OffsetWidth": 2,
            "AddrWidth": 1,
            "Address": 160,
            "WriteTmout": 100,
            "ReadTmout": 100,
            "RwBlockSize": 32,
            "WriteInterval": 20,
            "HealthStatus": 0
        },
        "Accessor_PcbID": {
            "Chip": "#/Chip_CPLD",
            "Offset": 5,
            "Size": 1,
            "Mask": 15,
            "Type": 0,
            "Value": 0
        },
        "Scanner_BoardId": {
            "Chip": "#/Chip_CPLD",
            "Offset": 4,
            "Size": 1,
            "Mask": 255,
            "Type": 0,
            "Period": 60000,
            "Value": 0
        },
        "PCIeDevice_1": {
            "DeviceName": "PCIe Card $ (HyperCard4.0)",
            "FunctionClass": 11,
            "DiagnosticFault": 0,
            "PredictiveFault": 0,
            "LinkSpeedReduced": 0,
            "CorrectableError": 0,
            "UncorrectableError": 0,
            "FatalError": 0,
            "Container": "${Container}",
            "GroupPosition": "PCIeDevice_${GroupPosition}",
            "DeviceType": 8
        },
        "Fru_DPUCard": {
            "FruId": 1,
            "PcbId": "#/Accessor_PcbID.Value",
            "PcbVersion": "",
            "FruName": "HyperCard4.0",
            "PowerState": 1,
            "Health": 0,
            "EepStatus": 1,
            "Type": 8,
            "BoardId": "<=/Scanner_BoardId.Value",
            "FruDataId": "#/FruData_DPUCard",
            "ConnectorGroupId": "${GroupId}"
        },
        "FruData_DPUCard": {
            "FruId": 1,
            "FruDev": "#/Chip_FRU",
            "EepromWp": 0,
            "StorageType": "ROStdEeprom"
        },
        "Component_DPUCard": {
            "FruId": "<=/Fru_DPUCard.FruId",
            "Instance": "<=/PCIeDevice_1.SlotID",
            "Type": 8,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "BoardId": "<=/Scanner_BoardId.Value",
            "Location": "<=/PCIeDevice_1.Position",
            "Manufacturer": "CMSoft",
            "PartNumber": "<=/FruData_DPUCard.BoardPartNumber",
            "Presence": 1,
            "UniqueId": "N/A",
            "Health": 0,
            "Function": "PCIe device(HyperCard4.0)",
            "PowerState": 1,
            "GroupId": 1,
            "SerialNumber": "<=/FruData_DPUCard.BoardSerialNumber"
        },
        "DPUCard_1": {
            "Model": "HyperCard4.0",
            "BoardID": "<=/Scanner_BoardId.Value",
            "BoardName": "HyperCard4.0",
            "Name": "HyperCard4.0",
            "Description": "HyperCard4.0",
            "FunctionClass": 11,
            "Architecture": "Panshi_ASIC_DPU",
            "TotalCores": 16,
            "PcbVersion": "<=/Fru_DPUCard.PcbVersion",
            "@Default": {
                "PcbVersion": ".A"
            },
            "SlotID": "<=/PCIeDevice_1.SlotID",
            "NodeID": "<=/PCIeDevice_1.SlotID |> string.format('HyperCard4.0_%s',$1)",
            "Manufacturer": "CMSoft",
            "RefBMCChip": "#/Chip_BMC",
            "RefCPLDChip": "#/Chip_CPLD",
            "HeartBeatLoss": 0,
            "SerialRecordConnect": [
                {
                    "Source": "UART4 COM",
                    "Destination": "CARD COM"
                }
            ],
            "RefFrudata": "#/FruData_DPUCard",
            "LinkWidth": "<=/PCIeDevice_1.LinkWidth",
            "VendorID": "#/NetworkAdapter_1.VendorID",
            "DeviceID": "#/NetworkAdapter_1.DeviceID",
            "SubVendorID": "#/NetworkAdapter_1.SubsystemVendorID",
            "SubDeviceID": "#/NetworkAdapter_1.SubsystemDeviceID",
            "Position": "<=/PCIeDevice_1.Position",
            "LaneOwner": "<=/PCIeDevice_1.SocketID",
            "DeviceName": "<=/PCIeDevice_1.DeviceName",
            "PartNumber": "<=/FruData_DPUCard.BoardPartNumber",
            "SerialNumber": "<=/FruData_DPUCard.BoardSerialNumber",
            "RefComponent": "#/Component_DPUCard",
            "ManagerType": "BMC",
            "SRVersion": "${DataVersion}"
        },
        "NetworkAdapter_1": {
            "SystemID": 1,
            "SlotNumber": "<=/PCIeDevice_1.SlotID",
            "NodeId": "<=/PCIeDevice_1.SlotID |> string.format('HyperCard4.0_%s',$1)",
            "Name": "HyperCard4.0",
            "Manufacturer": "CMSoft",
            "Position": "<=/PCIeDevice_1.Position",
            "DeviceLocator": "<=/PCIeDevice_1.DeviceName",
            "Type": 3,
            "Model": "HyperCard4.0",
            "NetworkPortCount": 2,
            "BoardID": "<=/Scanner_BoardId.Value",
            "VendorID": "0x1af4",
            "DeviceID": "0x1001",
            "SubsystemVendorID": "0x1af4",
            "SubsystemDeviceID": "0x0002",
            "PCBVersion": "<=/Fru_DPUCard.PcbVersion",
            "@Default": {
                "PCBVersion": ".A"
            },
            "FruId": "<=/FruData_DPUCard.FruId",
            "SupportedMctp": false,
            "SupportedLLDP": true,
            "HotPluggable": false,
            "ReadyToRemove": false,
            "AttentionHotPlugState": 255,
            "SocketId": "<=/PCIeDevice_1.SocketID",
            "Bus": "<=/PCIeDevice_1.Bus",
            "Device": "<=/PCIeDevice_1.Device",
            "Function": "<=/PCIeDevice_1.Function",
            "DevBus": "<=/PCIeDevice_1.DevBus",
            "DevDevice": "<=/PCIeDevice_1.DevDevice",
            "DevFunction": "<=/PCIeDevice_1.DevFunction",
            "RefChip": "#/Chip_BMC",
            "RefFruChip": "#/Chip_FRU",
            "RefCPLDChip": "#/Chip_CPLD",
            "SpecialPcieCard": false,
            "LinkWidthCapability": "N/A",
            "LinkSpeedCapability": "N/A",
            "LinkWidth": "N/A",
            "LinkSpeed": "N/A",
            "TemperatureCelsius": 0,
            "TemperatureStatus": 0,
            "ParentCardSlotId": "<=/PCIeDevice_1.SlotID",
            "FaultState": 0,
            "Health": "<=/Component_DPUCard.Health",
            "CardPowerGood": "<=/DPUCard_1.SystemLoadedStatus |> expr($1 == 255 ? 255 : 1)"
        },
        "NetworkPort_1": {
            "@Parent": "NetworkAdapter_1",
            "SystemID": 1,
            "PortID": 0,
            "NetDevFuncType": 1,
            "MediumType": "FiberOptic",
            "SupportedLinkCapability": "200GE"
        },
        "NetworkPort_2": {
            "@Parent": "NetworkAdapter_1",
            "SystemID": 1,
            "PortID": 1,
            "NetDevFuncType": 1,
            "MediumType": "FiberOptic",
            "SupportedLinkCapability": "200GE"
        },
        "OpticalModule_1": {
            "@Parent": "NetworkPort_1",
            "ChannelNum": 1
        },
        "OpticalModule_2": {
            "@Parent": "NetworkPort_2",
            "ChannelNum": 2
        },
        "Event_PcieCardReplaceMntr": {
            "EventKeyId": "PcieCard.PcieCardReplace",
            "Reading": "<=/Component_DPUCard.ReplaceFlag",
            "Condition": 1,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "AdditionalInfo": "1",
            "DescArg1": "#/Component_DPUCard.Name",
            "DescArg2": "#/Component_DPUCard.PreviousSN",
            "DescArg3": "#/Component_DPUCard.SerialNumber",
            "Component": "#/Component_DPUCard"
        },
        "Event_PCIeCardHeartBeatAbnormal": {
            "EventKeyId": "PCIeCard.PCIeCardHeartBeatAbnormal",
            "Reading": "<=/DPUCard_1.HeartBeatLoss",
            "ResumeEnable": 1,
            "Condition": 1,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "DescArg1": "<=/Component_DPUCard.Name",
            "Component": "#/Component_DPUCard",
            "LedFaultCode": "q$$"
        },
        "Event_PCIeCardUCE": {
            "EventKeyId": "PCIeCard.PCIeCardUncorrectableErr",
            "Reading": "<=/PCIeDevice_1.DiagnosticFault;<=/PCIeDevice_1.UCEByBIOS |> expr(($1 + $2) == 0 ? 0 : 1)",
            "ResumeEnable": 1,
            "Condition": 1,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "<=/Component_DPUCard.Name",
            "DescArg4": "NA",
            "Component": "#/Component_DPUCard",
            "LedFaultCode": "q$$"
        },
        "Event_PCIeCardCE": {
            "EventKeyId": "PCIeCard.PCIeCardCEHardFailure",
            "Reading": "<=/PCIeDevice_1.PredictiveFault",
            "ResumeEnable": 1,
            "Condition": 1,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "<=/Component_DPUCard.Name",
            "Component": "#/Component_DPUCard",
            "LedFaultCode": "q$$"
        },
        "Event_PCIeLinkSpeed": {
            "EventKeyId": "PCIeCard.PCIeCardLinkSpeedReduced",
            "Reading": "<=/PCIeDevice_1.LinkSpeedReduced",
            "ResumeEnable": 1,
            "Condition": 1,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "AdditionalInfo": "2",
            "DescArg2": "#/PCIeDevice_1.SlotID",
            "DescArg3": "(HyperCard4.0)",
            "Component": "#/Component_DPUCard"
        },
        "Event_NetworkAdapterOverTemp": {
            "EventKeyId": "PCIeCard.PCIeCardOverTemp",
            "Reading": "<=/DPUCard_1.NetworkAdapterChipTemperatureCelsius |> expr(($1 == 253 || $1 == 254 || $1 == 255) ? 0 : ($1 & 255))",
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_DPUCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_DPUCard.Name",
            "DescArg4": "#/Event_NetworkAdapterOverTemp.Reading",
            "DescArg5": "100",
            "Condition": 100,
            "Hysteresis": 2
        },
        "Event_NetworkAdapterTempFail": {
            "EventKeyId": "PcieCard.PCIeCardTempFail",
