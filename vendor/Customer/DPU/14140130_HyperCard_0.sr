            "Condition": 253,
            "OperatorId": 5,
            "Hysteresis": 0,
            "Enabled": true,
            "ResumeEnable": 1,
            "Component": "#/Component_DPUCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_DPUCard.Name"
        },
        "Event_OM1OverTempInfo": {
            "Reading": "<=/OpticalModule_1.TemperatureCelsius |> expr(($1 == 253 || $1 == 254) ? 0 : $1)",
