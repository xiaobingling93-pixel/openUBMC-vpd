            "DescArg5": "75",
            "Hysteresis": 2,
            "Component": "#/Component_DPUCard",
            "EventKeyId": "PcieCard.PCIeCardOMOverTemp",
            "Condition": 75,
            "LedFaultCode": "q$$"
        },
        "Event_SFP1TempFail": {
            "Reading": "<=/OpticalModule_1.TemperatureCelsius",
