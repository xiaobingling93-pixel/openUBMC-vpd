{
    "FormatVersion": "3.00",
    "DataVersion": "3.00",
    "Objects": {
        "FruData_Fru0": {
            "FruId": 1,
            "FruDev": "#/Eeprom_NIC",
            "EepromWp": 0,
            "BoardPartNumber": "N/A",
            "BoardSerialNumber": "N/A",
            "StorageType": "EepromStandard"
        },
        "Component_OCPCard": {
            "FruId": 255,
            "Instance": "${Slot}",
            "Type": 83,
            "BoardId": 65535,
            "Name": "<=/PCIeDevice_1.DeviceName",
            "Location": "<=/PCIeDevice_1.Position",
            "Manufacturer": "<=/NetworkAdapter_1.Manufacturer",
            "PartNumber": "<=/FruData_Fru0.BoardPartNumber",
            "UniqueId": "N/A",
            "Presence": 1,
            "Health": 0,
            "Function": "PCIe device",
            "GroupId": 1,
            "PowerState": 1,
            "SerialNumber": "<=/FruData_Fru0.BoardSerialNumber |> expr(string.gsub($1, '%s+$','') )"
        },
        "Fru_OCP": {
            "PcbVersion": ".A",
            "PowerState": 1,
            "Health": 0,
            "EepStatus": "<=/Eeprom_NIC.HealthStatus",
            "Type": 83,
            "FruDataId": "#/FruData_Fru0"
        },
        "ThresholdSensor_OCPTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_OCPCard.Id",
            "EntityInstance": "<=/Entity_OCPCard.Instance",
            "Initialization": 127,
            "Capabilities": 104,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "OCP${Slot} Temp",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/Scanner_NIC_Lm75.Value |> expr(($1 & 3840 == 0) ? $1 : ($1 & 255))",
            "ReadingStatus": "<=/Scanner_NIC_Lm75.Status"
        },
        "ThresholdSensor_OpticalModuleTemp": {
            "OwnerId": 32,
            "OwnerLun": 0,
            "EntityId": "<=/Entity_OCPCard.Id",
            "EntityInstance": "<=/Entity_OCPCard.Instance",
            "Initialization": 127,
            "Capabilities": 232,
            "SensorType": 1,
            "ReadingType": 1,
            "SensorName": "<=/PCIeDevice_1.SlotID |> string.format('OCP%s OP Temp', $1)",
            "Unit": 128,
            "BaseUnit": 1,
            "ModifierUnit": 0,
            "Analog": 1,
            "NominalReading": 25,
            "NormalMaximum": 0,
            "NormalMinimum": 0,
            "MaximumReading": 127,
            "MinimumReading": 128,
            "Reading": "<=/OpticalModule_0.TemperatureCelsius; <=/OpticalModule_1.TemperatureCelsius |> expr(($1 >= 255 ? 0 : $1) >= ($2 >= 255 ? 0 : $2) ? ($1 >= 255 ? 0 : $1) : ($2 >= 255 ? 0 : $2))",
            "ReadingStatus": "<=/OpticalModule_0.TemperatureCelsius;<=/OpticalModule_1.TemperatureCelsius;<=/OpticalModule_0.Presence;<=/OpticalModule_1.Presence |> expr(($3 == 0 && $4 == 0) || ($1 >= 255 && $2 >= 255) ? 3 : 0)"
        },
        "Entity_OCPCard": {
            "Id": 11,
            "Instance": 101,
            "Name": "Pcie Card",
            "Presence": 1,
            "PowerState": 1
        },
        "Event_OverTemp": {
            "Reading": "<=/Scanner_NIC_Lm75.Value |> expr(($1 >= 255) ? 30 : $1) |> expr($1 & 255)",
            "@Default": {
                "Condition": 105
            },
            "OperatorId": 4,
            "Enabled": true,
            "Component": "#/Component_OCPCard",
            "AdditionalInfo": "1",
            "DescArg2": "#/Component_OCPCard.Name",
            "DescArg4": "#/Event_OverTemp.Reading",
            "DescArg5": "#/ThresholdSensor_OCPTemp.UpperNoncritical"
        },
        "Event_OMOverTempInfo": {
            "Reading": "<=/OpticalModule_0.TemperatureCelsius; <=/OpticalModule_1.TemperatureCelsius |> expr($1 >= $2 ? $1 : $2) |> expr($1 > 255 ? 30 : $1)",
            "@Default": {
                "Condition": 70
            },
            "OperatorId": 4,
            "Enabled": false,
            "DescArg2": "#/Component_OCPCard.Name",
            "DescArg4": "#/Event_OMOverTempInfo.Reading",
            "DescArg5": "#/ThresholdSensor_OpticalModuleTemp.UpperNoncritical",
            "DescArg6": "0",
            "AdditionalInfo": "6",
            "Component": "#/Component_OCPCard"
        },
        "Event_TempFail": {
            "Reading": "<=/NetworkAdapter_1.TemperatureStatus",
            "OperatorId": 5,
            "Enabled": true,
            "Component": "#/Component_OCPCard",
            "AdditionalInfo": "2",
            "DescArg2": "#/Component_OCPCard.Name",
            "DescArg3": "NICCard Chip"
        },
