      "Presence": 1
    },
    "ThresholdSensor_NICTemp": {
      "OwnerId": 32,
      "OwnerLun": 0,
      "EntityId": "<=/Entity_Lom.Id",
      "EntityInstance": "<=/Entity_Lom.Instance",
      "Initialization": 127,
      "Capabilities": 104,
      "SensorType": 1,
      "ReadingType": 1,
      "SensorName": "NIC${Slot} Temp",
      "Unit": 128,
      "BaseUnit": 1,
      "Analog": 1,
      "NominalReading": 25,
      "MaximumReading": 127,
      "MinimumReading": 128,
      "Reading": "<=/Scanner_NicLm75.Value",
      "ReadingStatus": "<=/Scanner_NicLm75.Status;<=/Scanner_NicLm75.Value |> expr((($1 == 0) && ($2 > 255)) ? 2 : $1)",
      "SensorNumber": 255
    },
    "Event_NICCardReplaceMntr": {
      "Reading": "<=/Component_NICCard.ReplaceFlag",
      "OperatorId": 5,
      "Enabled": true,
