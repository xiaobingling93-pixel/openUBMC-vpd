    "Event_Port1LinkDown": {
      "Reading": "<=/NetworkAdapter_1.SlotNumber;<=/Scanner_Lom1Port1Link.Value;<=/Scanner_Lom2Port1Link.Value;<=/Scanner_Lom1Port1Link.Status;<=/Scanner_Lom2Port1Link.Status |> expr($1 == 1 ? ($4 == 0 ? $2 : 255) : ($5 == 0 ? $3 : 255))",
