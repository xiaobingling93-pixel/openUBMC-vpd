      "Reading": "<=/OpticalModule_1.ReadingCelsius;<=/OpticalModule_1.TemperatureUpperThresholdCritical |> expr(($1 == 65535 || $2 == 65535) ? 0 : ($1 > $2 ? 1 : 0))",
