      "Enabled": true,
      "DescArg1": "#/Component_NICCard.Name",
      "DescArg2": "1",
      "DescArg3": "#/OpticalModule_1.ReadingCelsius",
      "DescArg4": "#/OpticalModule_1.TemperatureUpperThresholdCritical",
